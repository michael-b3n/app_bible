#include <windows.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION @APP_VERSION_MAJOR@,@APP_VERSION_MINOR@,0,0
PRODUCTVERSION @APP_VERSION_MAJOR@,@APP_VERSION_MINOR@,0,0
FILEFLAGSMASK 0x17L
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"  // Language (English - United States)
    BEGIN
      VALUE "CompanyName", "@APP_NAME@"
      VALUE "FileDescription", "@APP_FILE_DESCRIPTION@"
      VALUE "FileVersion", "@APP_VERSION@"
      VALUE "InternalName", "@APP_NAME@"
      VALUE "OriginalFilename", "@APP_EXE_NAME@.exe"
      VALUE "ProductName", "@APP_NAME@"
      VALUE "ProductVersion", "@APP_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200  // English (US)
  END
END

1 24 "@CMAKE_CURRENT_LIST_DIR@/res/@APP_EXE_NAME@.exe.manifest"
IDI_ICON1	ICON	"@CMAKE_CURRENT_LIST_DIR@/res/icon.ico"
